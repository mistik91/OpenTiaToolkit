{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentiatoolkit.dev/schemas/benchmark-case.schema.json",
  "title": "OpenTiaToolkit OpenCode benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "fixtureId",
    "promptFile",
    "timeoutSeconds",
    "passScore",
    "allowedSkills",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ott-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1
    },
    "promptFile": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.md$"
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "passScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "allowedSkills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowWorkspaceEdits": {
      "type": "boolean",
      "default": false
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "enum": [
            "tool",
            "toolOperationSet",
            "forbiddenTool",
            "workspaceFile",
            "ladBooleanNetwork",
            "ladTimerNetwork",
            "finalRegex",
            "traceRegex",
            "run"
          ]
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "critical": {
          "type": "boolean"
        },
        "namePattern": {
          "type": "string"
        },
        "minCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0
        },
        "inputEquals": {
          "type": "object"
        },
        "operationPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
        },
        "expectedOperations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "normalizeResultReferences": {
          "type": "boolean"
        },
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "networkIndex": { "type": "integer", "minimum": 1 },
        "inputNames": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "expectedTrueRows": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 1023 } },
        "inputName": { "type": "string", "minLength": 1 },
        "outputName": { "type": "string", "minLength": 1 },
        "timerInstance": { "type": "string", "minLength": 1 },
        "presetMilliseconds": { "type": "number", "minimum": 0 },
        "minBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0
        },
        "requireUtf8Bom": {
          "type": "boolean"
        },
        "contentPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenContentPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pattern": {
          "type": "string"
        }
      }
    }
  }
}
