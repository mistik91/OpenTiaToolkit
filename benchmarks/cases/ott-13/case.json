{
  "schemaVersion": 1,
  "id": "ott-13",
  "title": "Guarded hardware output relocation",
  "description": "Tests transfer of guarded I/O relocation from an input module to an output module and a different address range.",
  "fixtureId": "tia-v21-io-2",
  "promptFile": "prompt.md",
  "timeoutSeconds": 420,
  "passScore": 85,
  "allowedSkills": [
    "opentia-toolkit-workflow",
    "basic-tia-interaction",
    "hardware-configuration-workflow"
  ],
  "assertions": [
    {
      "id": "run-completed",
      "type": "run",
      "points": 5,
      "critical": true
    },
    {
      "id": "hardware-tree",
      "type": "tool",
      "points": 10,
      "namePattern": "get_hardware_tree$",
      "minCount": 1,
      "outputPatterns": [
        "DQ_Candidate"
      ]
    },
    {
      "id": "output-baseline-and-readback",
      "type": "tool",
      "points": 15,
      "critical": true,
      "namePattern": "get_hardware_io_addresses$",
      "minCount": 2,
      "outputPatterns": [
        "DQ_Candidate",
        "\"Name\"\\s*:\\s*\"IoType\"\\s*,\\s*\"Value\"\\s*:\\s*\"Output\"",
        "\"Name\"\\s*:\\s*\"StartAddress\"\\s*,\\s*\"Value\"\\s*:\\s*\"130\""
      ]
    },
    {
      "id": "correct-guarded-output-operation",
      "type": "traceRegex",
      "points": 10,
      "critical": true,
      "pattern": "(?is)opentia_apply-hardware-patch.*?set-io-address-start.*?DQ_Candidate.*?addressIndex\"?\\s*:\\s*0.*?startAddress\"?\\s*:\\s*130.*?expectedStartAddress\"?\\s*:\\s*2"
    },
    {
      "id": "patch-preview",
      "type": "tool",
      "points": 20,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "minCount": 1,
      "maxCount": 1,
      "inputEquals": {
        "dry-run": true
      },
      "outputPatterns": [
        "\"DryRun\"\\s*:\\s*true",
        "\"Applied\"\\s*:\\s*false",
        "\"RolledBack\"\\s*:\\s*true",
        "\"IoType\"\\s*:\\s*\"Output\"",
        "\"BeforeStartAddress\"\\s*:\\s*2",
        "\"WrittenStartAddress\"\\s*:\\s*130"
      ]
    },
    {
      "id": "patch-apply",
      "type": "tool",
      "points": 30,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "minCount": 1,
      "maxCount": 1,
      "inputEquals": {
        "dry-run": false,
        "confirm": true
      },
      "outputPatterns": [
        "\"DryRun\"\\s*:\\s*false",
        "\"Applied\"\\s*:\\s*true",
        "\"IoType\"\\s*:\\s*\"Output\"",
        "\"BeforeStartAddress\"\\s*:\\s*2",
        "\"WrittenStartAddress\"\\s*:\\s*130"
      ]
    },
    {
      "id": "verified-final",
      "type": "finalRegex",
      "points": 10,
      "pattern": "(?is)(?=.*DQ_Candidate)(?=.*output)(?=.*130)(?=.*(appl|changed|relocat))(?=.*(verif|read.?back|confirm))"
    }
  ]
}
