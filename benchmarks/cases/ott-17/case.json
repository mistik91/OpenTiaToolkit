{
  "schemaVersion": 1,
  "id": "ott-17",
  "title": "Mixed I/O atomic rollback",
  "description": "Tests that a valid input relocation is rolled back when a later output relocation collides in the same transaction.",
  "fixtureId": "tia-v21-io-2",
  "promptFile": "prompt.md",
  "timeoutSeconds": 420,
  "passScore": 85,
  "allowedSkills": [
    "opentia-toolkit-workflow",
    "basic-tia-interaction",
    "hardware-configuration-workflow"
  ],
  "assertions": [
    {
      "id": "run-completed",
      "type": "run",
      "points": 5,
      "critical": true
    },
    {
      "id": "hardware-tree",
      "type": "tool",
      "points": 10,
      "namePattern": "get_hardware_tree$",
      "minCount": 1,
      "outputPatterns": [
        "DI_Candidate",
        "DQ_Candidate",
        "DQ_Occupied"
      ]
    },
    {
      "id": "baseline-and-rollback-readback",
      "type": "tool",
      "points": 20,
      "critical": true,
      "namePattern": "get_hardware_io_addresses$",
      "minCount": 2,
      "outputPatterns": [
        "DI_Candidate",
        "DQ_Candidate",
        "\"Name\"\\s*:\\s*\"IoType\"\\s*,\\s*\"Value\"\\s*:\\s*\"Input\"",
        "\"Name\"\\s*:\\s*\"IoType\"\\s*,\\s*\"Value\"\\s*:\\s*\"Output\"",
        "\"Name\"\\s*:\\s*\"StartAddress\"\\s*,\\s*\"Value\"\\s*:\\s*\"2\""
      ]
    },
    {
      "id": "one-guarded-mixed-patch",
      "type": "toolOperationSet",
      "points": 15,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "operationPath": "operations",
      "expectedOperations": [
        {
          "op": "set-io-address-start",
          "target": {
            "deviceName": "PLC_Main",
            "itemPath": ["DI_Candidate", "DI_Candidate"]
          },
          "addressIndex": 0,
          "startAddress": 66,
          "expectedStartAddress": 2
        },
        {
          "op": "set-io-address-start",
          "target": {
            "deviceName": "PLC_Main",
            "itemPath": ["DQ_Candidate", "DQ_Candidate"]
          },
          "addressIndex": 0,
          "startAddress": 128,
          "expectedStartAddress": 2
        }
      ],
      "minCount": 1,
      "maxCount": 1
    },
    {
      "id": "collision-preview",
      "type": "tool",
      "points": 25,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "minCount": 1,
      "maxCount": 1,
      "inputEquals": {
        "dry-run": true
      },
      "outputPatterns": [
        "(?i)already being used",
        "(?i)next free address[^0-9]*130"
      ]
    },
    {
      "id": "no-hardware-apply",
      "type": "forbiddenTool",
      "points": 15,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "inputEquals": {
        "dry-run": false
      }
    },
    {
      "id": "honest-rollback-final",
      "type": "finalRegex",
      "points": 5,
      "pattern": "(?is)(?=.*(collision|already being used|occupied))(?=.*DQ_Occupied)(?=.*130)(?=.*DI_Candidate)(?=.*DQ_Candidate)(?=.*(roll(?:ed)? back|both.{0,80}unchanged|unchanged.{0,80}both|neither.{0,80}changed|no (?:mutation|change)(?: was)? applied))"
    },
    {
      "id": "accurate-output-range-final",
      "type": "finalRegex",
      "points": 5,
      "critical": true,
      "pattern": "(?is)^(?!.*(?:128\\s*(?:-|\\u2013|to)\\s*143|next free(?: output)? byte\\s*(?:is|:)?\\s*144))(?=.*DQ_Occupied)(?=.*(?:128\\s*(?:-|\\u2013|to)\\s*129|16\\s*bits))(?=.*next free address[^0-9]*130).*$"
    }
  ]
}
