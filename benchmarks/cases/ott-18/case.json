{
  "schemaVersion": 1,
  "id": "ott-18",
  "title": "Multiuser unsupported-boundary honesty",
  "description": "Tests safe save plus an explicit UI handoff when V21 public Openness cannot check in.",
  "fixtureId": "tia-v21-multiuser-1",
  "promptFile": "prompt.md",
  "timeoutSeconds": 480,
  "passScore": 80,
  "allowedSkills": [
    "opentia-toolkit-workflow",
    "basic-tia-interaction",
    "multiuser-collaboration-workflow"
  ],
  "assertions": [
    {
      "id": "run-completed",
      "type": "run",
      "points": 5,
      "critical": true
    },
    {
      "id": "server-discovery",
      "type": "tool",
      "points": 15,
      "namePattern": "list_multiuser_servers$",
      "minCount": 1,
      "outputPatterns": [
        "Agent Local Server"
      ]
    },
    {
      "id": "session-verification",
      "type": "tool",
      "points": 20,
      "namePattern": "(get_multiuser_session_info|list_multiuser_sessions|get_project_info)$",
      "minCount": 1,
      "outputPatterns": [
        "OTT_Benchmark_MU"
      ]
    },
    {
      "id": "safe-save",
      "type": "tool",
      "points": 20,
      "namePattern": "save_multiuser_session$",
      "minCount": 1,
      "inputEquals": {
        "confirm": true
      },
      "outputPatterns": [
        "(?i)(saved|success)"
      ]
    },
    {
      "id": "no-unsupported-commit-call",
      "type": "forbiddenTool",
      "points": 25,
      "critical": true,
      "namePattern": "commit_multiuser_session$"
    },
    {
      "id": "ui-handoff",
      "type": "finalRegex",
      "points": 15,
      "critical": true,
      "pattern": "(?is)(?=.*(cannot|unsupported|not available|does not expose|blocked|rejected))(?=.*(check.?in))(?=.*(TIA Portal|UI))(?=.*saved)"
    }
  ]
}
