      "type": "traceRegex",
      "points": 10,
      "critical": true,
      "pattern": "(?is)opentia_apply-hardware-patch.*?set-io-address-start.*?DI_Occupied.*?addressIndex\"?\\s*:\\s*0.*?startAddress\"?\\s*:\\s*2.*?expectedStartAddress\"?\\s*:\\s*64"
    },
    {
      "id": "collision-preview",
      "type": "tool",
      "points": 25,
