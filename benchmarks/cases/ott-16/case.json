      "type": "finalRegex",
      "points": 15,
      "pattern": "(?is)(?=.*(collision|already being used|occupied))(?=.*DI_Candidate)(?=.*4)(?=.*(not apply|did not apply|no (?:mutation|change)(?: was)? applied|applied no (?:mutation|change)|unchanged))"
