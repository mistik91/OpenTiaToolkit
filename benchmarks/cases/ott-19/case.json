      "type": "tool",
      "points": 10,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "minCount": 2,
      "maxCount": 2
    },
    {
      "id": "single-preview",
      "type": "tool",
      "points": 15,
      "critical": true,
      "namePattern": "apply_hardware_patch$",
      "minCount": 1,
