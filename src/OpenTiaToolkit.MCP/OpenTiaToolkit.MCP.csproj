<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenTiaToolkit.MCP</AssemblyName>
    <RootNamespace>OpenTiaToolkit.MCP</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- TIA Openness API references - V19 installation (primary) -->
    <!-- In V19, the API is a monolithic assembly -->
    <Reference Include="Siemens.Engineering">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Delete Siemens Engineering DLLs from output directory after build to comply with Openness API requirements -->
  <Target Name="RemoveSiemensDllsFromOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutputPath)Siemens.Engineering.dll" Condition="Exists('$(OutputPath)Siemens.Engineering.dll')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\OpenTiaToolkit.Core\OpenTiaToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.4" />
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661">
      <Private>False</Private>
    </PackageReference>
    <!-- Note: Using custom TiaPortalAssemblyResolver instead of official resolver package -->
  </ItemGroup>

</Project>
