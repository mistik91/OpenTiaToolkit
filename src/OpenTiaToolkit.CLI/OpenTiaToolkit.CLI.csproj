<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenTiaToolkit.CLI</AssemblyName>
    <RootNamespace>OpenTiaToolkit.CLI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- TIA Openness API references - V21 installation (primary) -->
    <!-- In V21+, the API is modular: Base.dll, Step7.dll, WinCC.dll, WinCC.Extension.dll -->
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Delete Siemens Engineering DLLs from output directory after build to comply with Openness API requirements -->
  <Target Name="RemoveSiemensDllsFromOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutputPath)Siemens.Engineering.Base.dll" Condition="Exists('$(OutputPath)Siemens.Engineering.Base.dll')" />
    <Delete Files="$(OutputPath)Siemens.Engineering.Step7.dll" Condition="Exists('$(OutputPath)Siemens.Engineering.Step7.dll')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\OpenTiaToolkit.Core\OpenTiaToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661">
      <Private>False</Private>
    </PackageReference>
    <!-- Note: Using custom TiaPortalAssemblyResolver instead of official resolver package -->
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

</Project>
