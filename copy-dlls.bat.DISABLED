@echo off
echo Copying TIA Portal Openness DLLs to CLI output directory...

set CLI_DIR="C:\Users\ferreroluca\OneDrive - BOEMA S.P.A\VS PROJ\TiaMCP\src\OpenTiaToolkit.CLI\bin\Debug\net48"
set TIA_DIR="C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48"

echo Copying V21 API assemblies...
copy "%TIA_DIR%\Siemens.Engineering.Base.dll" "%CLI_DIR%\" /Y
copy "%TIA_DIR%\Siemens.Engineering.Step7.dll" "%CLI_DIR%\" /Y
copy "%TIA_DIR%\Siemens.Engineering.WinCC.dll" "%CLI_DIR%\" /Y
copy "%TIA_DIR%\Siemens.Engineering.WinCC.Extension.dll" "%CLI_DIR%\" /Y

echo.
echo V21 DLLs copied successfully!
echo You can now run the CLI from: %CLI_DIR%
echo.
pause
