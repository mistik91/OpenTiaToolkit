<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OpenTiaToolkit.Tests</AssemblyName>
    <RootNamespace>OpenTiaToolkit.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTiaToolkit.Core\OpenTiaToolkit.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenTiaToolkit.CLI\OpenTiaToolkit.CLI.csproj" />
    <ProjectReference Include="..\..\src\OpenTiaToolkit.MCP\OpenTiaToolkit.MCP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TIA Openness API references for integration tests - V19 installation (primary) -->
    <!-- In V19, the API is a monolithic assembly -->
    <Reference Include="Siemens.Engineering">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
      <CopyLocal>false</CopyLocal>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.9.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.assert" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- Delete Siemens Engineering DLLs from output directory after build to comply with Openness API requirements -->
  <Target Name="RemoveSiemensDllsFromOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutputPath)Siemens.Engineering.dll" Condition="Exists('$(OutputPath)Siemens.Engineering.dll')" />
  </Target>

</Project>
