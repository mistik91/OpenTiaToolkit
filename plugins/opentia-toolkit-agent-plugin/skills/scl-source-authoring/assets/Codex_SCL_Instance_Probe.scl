FUNCTION_BLOCK "Codex_SCL_Instance_Probe_FB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Value : Int;
END_VAR
VAR_OUTPUT
    Previous : Int;
END_VAR
VAR
    LastValue : Int;
END_VAR
BEGIN
    #Previous := #LastValue;
    #LastValue := #Value;
END_FUNCTION_BLOCK

