TYPE "Codex_SCL_Type_Probe_Record"
VERSION : 0.1
    STRUCT
        Enabled : Bool;
        Value : DInt;
    END_STRUCT;
END_TYPE

FUNCTION "Codex_SCL_Type_Probe" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
    VAR_INPUT
        Enable : Bool;
        InputValue : DInt;
    END_VAR
    VAR_IN_OUT
        State : "Codex_SCL_Type_Probe_Record";
    END_VAR
BEGIN
    #State.Enabled := #Enable;
    IF #Enable THEN
        #State.Value := #InputValue;
    END_IF;
END_FUNCTION
