<Project>
  <PropertyGroup>
    <!-- Default TIA Portal V21 PublicAPI path. Override with /p:TiaPortalPublicApiPath=... for non-standard installs. -->
    <TiaPortalPublicApiPath Condition="'$(TiaPortalPublicApiPath)' == ''">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPortalPublicApiPath>
    <LangVersion>12.0</LangVersion>
    <Version>1.0.0-preview.8</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-preview.8</InformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
