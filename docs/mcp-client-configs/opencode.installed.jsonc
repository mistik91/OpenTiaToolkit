// Add this file as:
//   Project scope: <ProjectRoot>\opencode.json
//   User scope:    C:\Users\<you>\.config\opencode\opencode.json
//
// This snippet assumes the product installer placed the MCP executable at:
//   C:\Program Files\OpenTiaToolkit\OpenTiaToolkit.MCP.exe

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "opentia": {
      "type": "local",
      "command": [
        "C:\\Program Files\\OpenTiaToolkit\\OpenTiaToolkit.MCP.exe"
      ],
      "environment": {
        "OPEN_TIA_MCP_LOG_LEVEL": "Error"
      },
      "enabled": true,
      "timeout": 600000
    }
  },
  "permission": {
    "skill": {
      "hmi-unified-agent-editing": "allow"
    }
  }
}
